source 'https://rubygems.org'

# Formerly-stdlib gems Jekyll still needs but that were dropped from Ruby's
# default gems: webrick (removed in 3.0, needed by `jekyll serve`),
# csv (removed in 3.4, required by some transitive deps), and
# bigdecimal (removed in 3.4, required by liquid).
gem 'webrick', '~> 1.8'
gem 'csv', '~> 3.3'
gem 'bigdecimal', '~> 3.1'

group :jekyll_plugins do
    gem 'jekyll', '~> 4.3'
    gem 'jekyll-sass-converter', '~> 2.0'
    gem 'jekyll-scholar', '~> 7.0'
end
